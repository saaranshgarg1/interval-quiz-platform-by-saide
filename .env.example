# Copy to .env and fill in. Not needed for local dev (built-in dev defaults are used).
# In production (NODE_ENV=production, e.g. docker compose) the API refuses to boot
# unless both secrets are set to independent random strings of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INTERVAL_JWT_SECRET=
INTERVAL_PASSWORD_PEPPER=

# Optional: restrict self-registration to these email domains (comma-separated), e.g. iitrpr.ac.in
INTERVAL_ALLOWED_EMAIL_DOMAINS=

# Optional: Google OAuth web client ID; leave empty to turn Google sign-in off
INTERVAL_GOOGLE_CLIENT_ID=
